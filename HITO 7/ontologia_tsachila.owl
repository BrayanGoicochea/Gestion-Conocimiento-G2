<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologia_tsachila#"
     xml:base="http://www.semanticweb.org/ontologia_tsachila#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologia_tsachila">
        <rdfs:comment xml:lang="es">Ontología formal del Conocimiento Etnobotánico y Medicina Ancestral Tsáchila.</rdfs:comment>
        <rdfs:label xml:lang="es">Ontología Etnobotánica Tsáchila</rdfs:label>
    </owl:Ontology>

    <owl:Class rdf:about="http://www.semanticweb.org/ontologia_tsachila#Planta">
        <rdfs:label xml:lang="es">Planta</rdfs:label>
        <rdfs:comment xml:lang="es">Entidad vegetal empleada en la medicina tradicional Tsáchila</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/ontologia_tsachila#Patologia">
        <rdfs:label xml:lang="es">Patologia</rdfs:label>
        <rdfs:comment xml:lang="es">Enfermedad, síntoma o dolencia tratada</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/ontologia_tsachila#PartePlanta">
        <rdfs:label xml:lang="es">PartePlanta</rdfs:label>
        <rdfs:comment xml:lang="es">Órgano vegetal utilizado (hojas, corteza, fruto, raíz, etc.)</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/ontologia_tsachila#Preparacion">
        <rdfs:label xml:lang="es">Preparacion</rdfs:label>
        <rdfs:comment xml:lang="es">Forma galénica o ritual de elaboración del remedio</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/ontologia_tsachila#FamiliaBotanica">
        <rdfs:label xml:lang="es">FamiliaBotanica</rdfs:label>
        <rdfs:comment xml:lang="es">Taxonomía botánica de las especies</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/ontologia_tsachila#NombreTsafiqui">
        <rdfs:label xml:lang="es">NombreTsafiqui</rdfs:label>
        <rdfs:comment xml:lang="es">Denominación vernácula en lengua tsáfiqui</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/ontologia_tsachila#NombreCientifico">
        <rdfs:label xml:lang="es">NombreCientifico</rdfs:label>
        <rdfs:comment xml:lang="es">Nomenclatura botánica binomial</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/ontologia_tsachila#Receta">
        <rdfs:label xml:lang="es">Receta</rdfs:label>
        <rdfs:comment xml:lang="es">Fórmula medicinal tradicional compuesta</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/ontologia_tsachila#Actor">
        <rdfs:label xml:lang="es">Actor</rdfs:label>
        <rdfs:comment xml:lang="es">Especialista o practicante tradicional de la salud (p. ej., Poné)</rdfs:comment>
    </owl:Class>

